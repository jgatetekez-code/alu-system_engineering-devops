#!/usr/bin/env bash
# Configure ufw: block all incoming traffic except TCP ports 22, 80 and 443
apt-get update -y
apt-get install -y ufw
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw --force enable
service ufw restart
ufw reload
ufw status verbose
